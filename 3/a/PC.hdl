// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
     //increment
    Inc16(in=backout , out=incout );
    Mux16(a=backout, b=incout , sel=inc , out=increment );
    //reset decision
    Mux16(a=increment , b=in , sel= load, out=loadyn );
    //load decision
    Mux16(a=loadyn , b=false, sel=reset , out=resetyn);
   
    
    
    Register(in=resetyn , load=true , out=backout,out=out );
    
}